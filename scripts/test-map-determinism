#!/usr/bin/env python3
"""Proves a scenario gets the same map in two separate game launches (orum/rimhunter#8).

Runs two launches of the same scenarios and compares the map seed and the fingerprint of the
generated map (terrain, edifices and things before the runner clears it) from each result file.
Extra arguments go to scripts/run-scenarios.
"""
import json
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
SCENARIOS = ["starts-with-no-errors", "selftest-pass", "opportunity-job-report-says-on-the-way-to"]


def launch(work, name, extra, no_build):
    result = os.path.join(work, name + ".json")
    cmd = [os.path.join(HERE, "run-scenarios"), "-s", ",".join(SCENARIOS), "--result-file", result,
           "--work-dir", os.path.join(work, name)] + (["--no-build"] if no_build else []) + extra
    rc = subprocess.run(cmd).returncode
    if rc != 0:
        sys.exit("launch %s failed with exit %d" % (name, rc))
    with open(result, encoding="utf-8") as f:
        return {s["name"]: (s.get("map_seed"), s.get("map_fingerprint")) for s in json.load(f)["scenarios"]}


def main():
    extra = sys.argv[1:]
    with tempfile.TemporaryDirectory(prefix="wyu-determinism.") as work:
        first = launch(work, "first", extra, False)
        second = launch(work, "second", extra, True)
    bad = False
    for name in SCENARIOS:
        a, b = first.get(name), second.get(name)
        same = a is not None and a == b and a[0] is not None and a[1]
        print("%s %s seed/fingerprint %s vs %s" % ("SAME" if same else "DIFFERENT", name, a, b))
        bad |= not same
    print("OVERALL: " + ("FAIL" if bad else "PASS"))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
